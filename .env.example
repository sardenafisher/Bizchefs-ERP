# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SUPABASE_URL: URL of your Supabase PostgreSQL instance (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Client-safe anonymous public key for Supabase Auth and RLS operations
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# SUPABASE_SERVICE_ROLE_KEY: Privileged server-only key for migrations and secure edge functions. NEVER expose in frontend.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
